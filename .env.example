# ============================================================================
#  Jacks of All Trades — environment variable TEMPLATE (safe to commit)
#  File: .env.example
#  Generated: 2026-09-05 15:35 UTC
#
#  Copy to `.env` (git-ignored) for LOCAL testing only. In production these are
#  set as SERVER-SIDE secrets, never shipped to the browser:
#    - Supabase:  supabase secrets set NAME=value
#    - Vercel:    Project → Settings → Environment Variables
#  DO NOT put the real Zeffy key in the front-end (assets/js/config.js).
# ============================================================================

# --- Zeffy (server-side ONLY — read access to donations & donor contacts) ---
ZEFFY_API_KEY=your-zeffy-api-key-here
# Confirm the exact base URL + auth from your Zeffy dashboard's interactive API
# docs (Settings → Organization → Integrations → API). Override if different:
ZEFFY_API_BASE=https://api.zeffy.com
ZEFFY_AUTH_HEADER=Authorization           # or: x-api-key
ZEFFY_AUTH_SCHEME=Bearer                  # prefix for Authorization; blank for x-api-key
ZEFFY_RAFFLE_CAMPAIGN_ID=                 # the campaign/form id for the 50/50 raffle

# --- Supabase (service role is server-side ONLY; anon key is public) --------
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-server-side-only
# Public anon key belongs in assets/js/config.js (safe with RLS), not here.
