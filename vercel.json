{
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/donate", "destination": "https://www.zeffy.com/en-US/ticketing/jacks-of-all-trades-community-development", "permanent": false },
    { "source": "/give", "destination": "https://www.zeffy.com/en-US/ticketing/jacks-of-all-trades-community-development", "permanent": false },
    { "source": "/raffle-tickets", "destination": "https://www.zeffy.com/en-US/ticketing/jacks-of-all-trades-community-development", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
